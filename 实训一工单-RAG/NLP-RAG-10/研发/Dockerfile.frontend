# NLP-RAG Frontend Dockerfile - Lightweight

FROM python:3.10

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install minimal dependencies
RUN pip install --no-cache-dir --break-system-packages \
    fastapi \
    uvicorn \
    gradio \
    requests

# Copy frontend code
COPY frontend/ ./frontend/

EXPOSE 7860

CMD ["python", "-m", "uvicorn", "frontend.main:app", "--host", "0.0.0.0", "--port", "7860"]
